{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        {
            "src": "^/build/(.*)$",
            "dest": "/public/build/$1"
        },
        {
            "src": "^/images/(.*)$",
            "dest": "/public/images/$1"
        },
        {
            "src": "^/css/(.*)$",
            "dest": "/public/css/$1"
        },
        {
            "src": "^/js/(.*)$",
            "dest": "/public/js/$1"
        },
        {
            "src": "^/Potensi Desa/(.*)$",
            "dest": "/public/Potensi Desa/$1"
        },
        {
            "src": "^/favicon\\.(ico|png)$",
            "dest": "/public/favicon.$1"
        },
        {
            "src": "^/robots\\.txt$",
            "dest": "/public/robots.txt"
        },
        {
            "src": "^/(.*)$",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "VERCEL": "1",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://satujarak.vercel.app",
        "ASSET_URL": "/",
        "APP_KEY": "base64:TqE+IH5D48ZZx5ecfgYBPhawzaVq4m8mMlzP/3XmLIo=",
        "APP_CONFIG_CACHE": "/tmp/storage/config.php",
        "APP_EVENTS_CACHE": "/tmp/storage/events.php",
        "APP_PACKAGES_CACHE": "/tmp/storage/packages.php",
        "APP_ROUTES_CACHE": "/tmp/storage/routes.php",
        "APP_SERVICES_CACHE": "/tmp/storage/services.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie"
    }
}
